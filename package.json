{
  "name": "carveout",
  "version": "0.1.1",
  "description": "Hand one part of a closed TypeScript repository to an outside contractor: a slice, stubbed and mocked, that installs, builds and tests on its own, and a checked patch back. Also checks a change made in the repository: what it reaches, the tests to run, and weakened tests or config edits.",
  "keywords": [
    "carveout",
    "open-source",
    "closed-source",
    "private-repository",
    "contractor",
    "outsourcing",
    "inner-source",
    "agent-skills",
    "repository-slicing",
    "code-slicing",
    "monorepo",
    "extract",
    "stubs",
    "mocks",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "typescript",
    "impact-analysis",
    "test-impact-analysis",
    "test-selection",
    "guardrails"
  ],
  "homepage": "https://github.com/lunox-work/carveout#readme",
  "bugs": {
    "url": "https://github.com/lunox-work/carveout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/carveout.git"
  },
  "license": "MIT",
  "author": "Charlie Angriawan",
  "type": "module",
  "bin": {
    "carveout": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "AGENTS.md",
    "NOTICE.md",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --import ./dist/test/setup.js --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
