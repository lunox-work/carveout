{
  "name": "carveout",
  "version": "0.1.0",
  "description": "Check what a change to a TypeScript repository reaches (importers, changed exports, the tests to run) and hold weakened tests and config edits; or carve a slice of the repository, stubbed and mocked, for someone who should see only part of it.",
  "keywords": [
    "carveout",
    "repository-slicing",
    "code-slicing",
    "monorepo",
    "extract",
    "stubs",
    "mocks",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "typescript",
    "impact-analysis",
    "test-impact-analysis",
    "test-selection",
    "guardrails"
  ],
  "homepage": "https://github.com/lunox-work/carveout#readme",
  "bugs": {
    "url": "https://github.com/lunox-work/carveout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/carveout.git"
  },
  "license": "MIT",
  "author": "Charlie Angriawan",
  "type": "module",
  "bin": {
    "carveout": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "AGENTS.md",
    "NOTICE.md",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
